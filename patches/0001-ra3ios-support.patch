+use std::collections::HashMap;
 use std::io::{Read, Seek, SeekFrom, Write};
+use std::sync::LazyLock;
+
+/// Locate the EA FUFS archive used to emulate the game VFS.
+fn vfs_archive_path() -> Option<&'static str> {
+    ["touchHLE_apps/Red Alert.app/data.vfs", "data.vfs"]
+        .into_iter()
+        .find(|p| std::path::Path::new(p).is_file())
+}
+
+/// Entry in the EA "FUFS" `data.vfs` archive (offset, size).
+struct VfsEntry {
+    offset: u64,
+    size: u32,
+}
+
+/// Lazily-parsed index of `./data.vfs`, keyed by the engine's filename hash.
+/// This is used to emulate the app's own VFS layer, which does not work
+/// correctly under touchHLE (it falls back to ordinary file I/O, which then
+/// fails because the app bundle contains no loose asset files).
+static VFS_INDEX: LazyLock<Option<HashMap<u32, VfsEntry>>> = LazyLock::new(|| {
+    let data = vfs_archive_path().and_then(|p| std::fs::read(p).ok())?;
+    if data.len() < 12 || &data[0..4] != b"FUFS" {
+        return None;
+    }
+    let count = u32::from_le_bytes(data[8..12].try_into().unwrap()) as usize;
+    let mut map = HashMap::with_capacity(count);
+    for i in 0..count {
+        let o = 12 + i * 12;
+        if o + 12 > data.len() {
+            break;
+        }
+        let offset = u32::from_le_bytes(data[o..o + 4].try_into().unwrap()) as u64;
+        let hash = u32::from_le_bytes(data[o + 4..o + 8].try_into().unwrap());
+        let size = u32::from_le_bytes(data[o + 8..o + 12].try_into().unwrap());
+        map.insert(hash, VfsEntry { offset, size });
+    }
+    Some(map)
+});
+
+/// The engine's filename hash: `h = h * 67 + c - 0x71`, after normalising
+/// backslashes to slashes and uppercasing ASCII letters.
+fn ea_vfs_hash(path: &str) -> u32 {
+    let mut h: u32 = 0;
+    for ch in path.chars() {
+        let mut c = ch as u32;
+        if c == 0x5c {
+            c = 0x2f;
+        }
+        if (0x61..=0x7a).contains(&c) {
+            c -= 0x20;
+        }
+        h = h.wrapping_mul(67).wrapping_add(c).wrapping_sub(0x71);
+    }
+    h
+}
+
+/// Turn a guest path into the key used by the app's VFS: paths inside the app
+/// bundle are relative to the bundle, everything else is relative to the root.
+fn vfs_key(path: &str) -> &str {
+    if let Some(idx) = path.find(".app/") {
+        return &path[idx + 5..];
+    }
+    path.trim_start_matches(['/', '\\'])
+}
+
+/// Try to satisfy an open from `data.vfs`. Returns a file descriptor on
+/// success. The entry is extracted into `vfs_cache/` on first use, so ordinary
+/// file semantics (seek, size) work.
+fn try_vfs_fallback(
+    env: &mut Environment,
+    path: &str,
+    flags: i32,
+) -> Option<FileDescriptor> {
+    if flags & O_ACCMODE != O_RDONLY {
+        return None;
+    }
+    let index = VFS_INDEX.as_ref()?;
+    let key = vfs_key(path);
+    let hash = ea_vfs_hash(key);
+    let entry = index.get(&hash)?;
+
+    let cache_dir = std::path::PathBuf::from("vfs_cache");
+    let _ = std::fs::create_dir_all(&cache_dir);
+    let cache_path = cache_dir.join(format!("{:08x}.bin", hash));
+    if !cache_path.exists() {
+        let mut src = std::fs::File::open(vfs_archive_path()?).ok()?;
+        src.seek(SeekFrom::Start(entry.offset)).ok()?;
+        let mut buf = vec![0u8; entry.size as usize];
+        src.read_exact(&mut buf).ok()?;
+        std::fs::write(&cache_path, &buf).ok()?;
+    }
+    let file = GuestFile::from_host_path(&cache_path).ok()?;
+    log!("VFS fallback: {:?} -> data.vfs entry (hash {:08x}, {} bytes)", path, hash, entry.size);
+    Some(find_or_create_fd(
+        env,
+        PosixFileHostObject {
+            file,
+            needs_flush: false,
+            reached_eof: false,
+            flags: 0,
+        },
+    ))
+}
 
